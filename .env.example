# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=RAG API

# Elasticsearch Settings
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=alice_data
ELASTICSEARCH_USERNAME=elastic_name
ELASTICSEARCH_PASSWORD=password

# Embedding Model Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Ranker Settings
RANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Settings
DENSE_RETRIEVER_TOP_K=10
BM25_RETRIEVER_TOP_K=10
RANKER_TOP_K=5
DEFAULT_QUERY_TOP_K=3
INDEXING_CONTEXT_WINDOW=2
MIN_RETRIEVAL_SCORE=0.05
SOURCE_CHUNK_SCORE_THRESHOLD=0.4


SPLIT_BY=sentence
CHUNK_SIZE=500
CHUNK_OVERLAP=80
